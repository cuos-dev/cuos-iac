set nocompatible
source $VIMRUNTIME/vimrc_example.vim

let perl_include_pod = 1
let perl_string_as_statement = 1
syntax on
"set ai
set history=50
set ignorecase
set ts=8 sw=8 sm vb so=1 nobk ssl ls=2
"set nu
set tenc=utf-8
set enc=utf-8
nno <F11> :bN<CR>
nno <F12> :bn<CR>
nnoremap f :bn<CR>
nnoremap b :bp<CR>

set mouse-=a

nnoremap <F2> :set invpaste paste?<CR>
set pastetoggle=<F2>
set showmode

set whichwrap+=<,>,[,]
autocmd Filetype json setlocal ts=4 sw=4 sts=0 noexpandtab
