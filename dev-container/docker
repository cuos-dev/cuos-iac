#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -uo pipefail

# --- Configuration ---
# Path to the real docker binary (avoid recursion)
DOCKER_REAL="${DOCKER_REAL:-/usr/bin/docker}"

# Path mapper (container path -> host path); must read from STDOUT
HOST_MAP_BIN="${HOST_MAP_BIN:-cuos-host-path}"

# Set DEBUG=1 to see rewrites
DEBUG="${DEBUG:-0}"

# --- Helpers ---

log_debug() {
  if [ "$DEBUG" = "1" ]; then
    printf '[docker-wrap] %s\n' "$*" >&2
  fi
}

# detect if string looks like a filesystem path, not a named volume
looks_like_path() {
  case "$1" in
    /*|./*|../*|~|~/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Minimal, safe tilde expansion: ~ and ~/ only (no ~user)
expand_tilde_minimal() {
  local p="$1"
  # shellcheck disable=SC2088
  case "$p" in
    "~")   printf '%s' "${HOME:-$p}";;
    "~/"*) printf '%s/%s' "${HOME:-~}" "${p#~/}";;
    *)     printf '%s' "$p";;
  esac
}

# Call cuos-host-path (after tilde expansion); keep original if mapping fails/empty
map_path_or_keep() {
  local in="$1"
  local in2 out
  in2="$(expand_tilde_minimal "$in")"

  if [[ "$(LC_ALL=C type -t "$DOCKER_REAL")" != "function" ]] && \
      ! command -v "$HOST_MAP_BIN" >/dev/null 2>&1; then
    log_debug "Mapper '$HOST_MAP_BIN' not found; keeping: $in2"
    printf '%s' "$in2"
    return 0
  fi

  if ! out="$("$HOST_MAP_BIN" "$in2" 2>/dev/null)"; then
    out=""
  fi
  if [ -n "$out" ]; then
    log_debug "Mapped: '$in' -> '$out'"
    printf '%s' "$out"
  else
    log_debug "Mapping returned empty; keeping: $in2"
    printf '%s' "$in2"
  fi
}

# Rewrite a single -v/--volume spec: SRC:DEST[:OPTS]
# Anonymous volume (":/dest") and named volume ("name:/dest") pass through.
rewrite_volume_spec() {
  local spec="$1"

  # must contain at least one colon
  if [[ "$spec" != *:* ]]; then
    printf '%s' "$spec"
    return 0
  fi

  local src="${spec%%:*}"      # up to first colon (may be empty)
  local rest="${spec#"$src"}"
  rest="${rest#:}"             # remove the colon

  # Anonymous volume
  if [ -z "$src" ]; then
    printf '%s' "$spec"
    return 0
  fi

  # Named volume?
  if ! looks_like_path "$src"; then
    printf '%s' "$spec"
    return 0
  fi

  local mapped
  mapped="$(map_path_or_keep "$src")"
  printf '%s:%s' "$mapped" "$rest"
}

# Split --mount spec on commas, but respect single/double quotes
split_mount_fields() {
  local spec="$1"
  local -a fields=()
  local buf=""
  local in_s=0 in_d=0
  local i ch

  for ((i=0; i<${#spec}; i++)); do
    ch="${spec:i:1}"
    if [ "$ch" = "'" ] && [ $in_d -eq 0 ]; then
      in_s=$((1-in_s)); buf+="$ch"; continue
    fi
    if [ "$ch" = '"' ] && [ $in_s -eq 0 ]; then
      in_d=$((1-in_d)); buf+="$ch"; continue
    fi
    if [ "$ch" = "," ] && [ $in_s -eq 0 ] && [ $in_d -eq 0 ]; then
      fields+=("$buf"); buf=""
    else
      buf+="$ch"
    fi
  done
  fields+=("$buf")
  printf '%s\0' "${fields[@]}"
}

strip_outer_quotes() {
  # echo unquoted + original quote char (if any) separated by \n
  local v="$1"
  if [[ "$v" == \"*\" && "$v" == *\" ]]; then
    printf '%s\n%s' "${v:1:${#v}-2}" '"'
  elif [[ "$v" == \'*\' && "$v" == *\' ]]; then
    printf '%s\n%s' "${v:1:${#v}-2}" "'"
  else
    printf '%s\n' "$v"
  fi
}

# Rewrite --mount spec when type=bind (src=/ source=/)
rewrite_mount_spec() {
  local spec="$1"

  # Fast path: only operate on bind mounts
  case "$spec" in
    *type=bind*|*type\ *=\ *bind*) ;;
    *) printf '%s' "$spec"; return 0 ;;
  esac

  # Split fields safely
  mapfile -d '' -t fields < <(split_mount_fields "$spec")
  local out_fields=()
  local key val unq quote mapped

  for kv in "${fields[@]}"; do
    if [[ "$kv" =~ ^([[:space:]]*src|[[:space:]]*source)[[:space:]]*=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      val="${BASH_REMATCH[2]}"

      # preserve outer quotes
      IFS=$'\n' read -r unq quote < <(strip_outer_quotes "$val")
      # tilde-expand (safe) then map if looks like path
      if looks_like_path "$unq"; then
        mapped="$(map_path_or_keep "$unq")"
        if [ -n "$quote" ]; then
          out_fields+=("${key}=${quote}${mapped}${quote}")
        else
          out_fields+=("${key}=${mapped}")
        fi
      else
        out_fields+=("$kv")
      fi
    else
      out_fields+=("$kv")
    fi
  done

  # Only return modified spec for bind mounts (but keep other fields intact)
  printf '%s' "$(IFS=,; echo "${out_fields[*]}")"
}

# Expand combined short options like -itv/... into -i -t -v<spec>
expand_short_cluster() {
  local arg="$1"
  local rest="${arg#-}"
  local tokens=()
  local i c

  for ((i=0; i<${#rest}; i++)); do
    c="${rest:i:1}"
    if [ "$c" = "v" ]; then
      local tail="${rest:i+1}"
      if [ -n "$tail" ]; then
        tokens+=("-v$tail")
      else
        tokens+=("-v")
      fi
      # The remainder is consumed by -v; stop splitting here
      break
    else
      tokens+=("-$c")
    fi
  done
  # If we stopped before end but not because of v, we may have leftover (rare); ignore.
  printf '%s\0' "${tokens[@]}"
}

# --- docker compose ---
# The paths in a compose file are paths in this container, and the daemon
# resolves them on the host. For the commands that create containers the file
# is rendered, the sources the daemon mounts are mapped, and compose runs on the
# result. The build context, env_file and the like are read by compose itself
# and stay as they are.
COMPOSE_CREATING=" up create run watch scale "

compose_map_sources() {
  local config="$1"
  local updates="[]" line path src
  while IFS= read -r line; do
    path="$(jq -c '.[0]' <<<"$line")"
    src="$(jq -r '.[1]' <<<"$line")"
    looks_like_path "$src" || continue
    updates="$(jq -c --argjson p "$path" --arg v "$(map_path_or_keep "$src")" \
      '. + [[$p, $v]]' <<<"$updates")"
  done < <(jq -c '
    (.services // {} | to_entries[] | .key as $s
      | (.value.volumes // []) | to_entries[]
      | select(.value.type == "bind")
      | [["services", $s, "volumes", .key, "source"], .value.source]),
    (("secrets", "configs") as $k | (.[$k] // {}) | to_entries[]
      | select(.value.file)
      | [[$k, .key, "file"], .value.file]),
    (.volumes // {} | to_entries[]
      | select((.value.driver_opts.o // "") | split(",") | index("bind"))
      | select(.value.driver_opts.device)
      | [["volumes", .key, "driver_opts", "device"], .value.driver_opts.device])
  ' <<<"$config")

  # The rendering already holds only the active services; their profiles go, so
  # that a COMPOSE_PROFILES from the project's .env still counts.
  jq --argjson u "$updates" '
    reduce $u[] as $x (.; setpath($x[0]; $x[1]))
    | if has("services") then .services |= map_values(del(.profiles)) else . end
  ' <<<"$config"
}

COMPOSE_RENDERED=""

run_compose() {
  local -a global=() rest=()
  local sub="" from_stdin=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--file|-p|--project-name|--project-directory|--env-file|--profile|--parallel|--ansi|--progress)
        if [[ "$1" == -f || "$1" == --file ]] && [ "${2:-}" = "-" ]; then
          from_stdin=1
        fi
        global+=("$1"); shift
        if [ "$#" -gt 0 ]; then global+=("$1"); shift; fi
        ;;
      -f-|-f=-|--file=-)
        from_stdin=1; global+=("$1"); shift ;;
      -*)
        global+=("$1"); shift ;;
      *)
        sub="$1"; rest=("$@"); break ;;
    esac
  done

  if [ "$from_stdin" = 1 ] || [[ "$COMPOSE_CREATING" != *" $sub "* ]]; then
    "$DOCKER_REAL" compose "${global[@]}" "${rest[@]}"
    return
  fi

  # Without a valid project, compose's own error comes from the command as given.
  local config
  if ! config="$("$DOCKER_REAL" compose "${global[@]}" config --format json 2>/dev/null)"; then
    "$DOCKER_REAL" compose "${global[@]}" "${rest[@]}"
    return
  fi

  local -a keep=()
  local i=0
  while [ "$i" -lt "${#global[@]}" ]; do
    case "${global[i]}" in
      -f|--file) i=$((i + 2)); continue ;;
      -f*|--file=*) i=$((i + 1)); continue ;;
    esac
    keep+=("${global[i]}"); i=$((i + 1))
  done

  # A file, not stdin: `compose run -it` needs the terminal.
  COMPOSE_RENDERED="$(mktemp --suffix=.json)" || return 1
  trap 'rm -f "$COMPOSE_RENDERED"' EXIT
  compose_map_sources "$config" >"$COMPOSE_RENDERED" || return 1
  log_debug "Compose file rendered to $COMPOSE_RENDERED"

  "$DOCKER_REAL" compose "${keep[@]}" -f "$COMPOSE_RENDERED" "${rest[@]}"
}

# --- Parse args and rewrite ---
OUT_ARGS=()
END_OF_OPTS=0

while [ "$#" -gt 0 ]; do
  arg="$1"
  shift

  if [ "$END_OF_OPTS" -eq 1 ]; then
    OUT_ARGS+=("$arg")
    continue
  fi

  case "$arg" in
    --)
      OUT_ARGS+=("--")
      # pass through the rest unchanged
      while [ "$#" -gt 0 ]; do OUT_ARGS+=("$1"); shift; done
      END_OF_OPTS=1
      ;;

    # -v with separate value
    -v)
      if [ "$#" -eq 0 ]; then OUT_ARGS+=("-v"); break; fi
      spec="$1"; shift
      OUT_ARGS+=("-v" "$(rewrite_volume_spec "$spec")")
      ;;

    # -v=spec, -vspec (including absolute/relative/tilde)
    -v=*|-v/*|-v./*|-v../*|-v~*|-v:*)
      spec="${arg#-v=}"
      spec="${spec#-v}"
      OUT_ARGS+=("-v" "$(rewrite_volume_spec "$spec")")
      ;;

    # --volume with separate value
    --volume)
      if [ "$#" -eq 0 ]; then OUT_ARGS+=("--volume"); break; fi
      spec="$1"; shift
      OUT_ARGS+=("--volume" "$(rewrite_volume_spec "$spec")")
      ;;

    # --volume=spec
    --volume=*)
      spec="${arg#--volume=}"
      OUT_ARGS+=("--volume=$(rewrite_volume_spec "$spec")")
      ;;

    # --mount with separate value
    --mount)
      if [ "$#" -eq 0 ]; then OUT_ARGS+=("--mount"); break; fi
      mspec="$1"; shift
      OUT_ARGS+=("--mount" "$(rewrite_mount_spec "$mspec")")
      ;;

    # --mount=spec
    --mount=*)
      mspec="${arg#--mount=}"
      OUT_ARGS+=("--mount=$(rewrite_mount_spec "$mspec")")
      ;;

    # Boolean flags combined with -v: -itv/home:/mnt:ro, rm -fv.
    # Any other letter takes a value (-p8080:80, -eFOO=bar, -w/srv) or is not
    # docker's at all (find -name), and the argument stays as it is.
    -[dfiPqt]*v*)
      if [[ "$arg" =~ ^-[dfiPqt]+v ]]; then
        mapfile -d '' -t expanded < <(expand_short_cluster "$arg")
        # Prepend expanded tokens back to the input stream, then continue
        set -- "${expanded[@]}" "$@"
      else
        OUT_ARGS+=("$arg")
      fi
      ;;

    *)
      OUT_ARGS+=("$arg")
      ;;
  esac
done

# --- Exec real docker ---
if [[ "$(LC_ALL=C type -t "$DOCKER_REAL")" != "function" && ! -x "$DOCKER_REAL" ]]; then
  printf 'Error: DOCKER_REAL not executable or not found: %s\n' "$DOCKER_REAL" >&2
  exit 127
fi

if [ "$DEBUG" = "1" ]; then
  printf '[docker-wrap] Exec: %s' "$DOCKER_REAL" >&2
  for a in "${OUT_ARGS[@]}"; do printf ' %q' "$a" >&2; done
  printf '\n' >&2
fi

if [ "${OUT_ARGS[0]:-}" = "compose" ]; then
  run_compose "${OUT_ARGS[@]:1}"
  exit "$?"
fi

"$DOCKER_REAL" "${OUT_ARGS[@]}"
exit "$?"
