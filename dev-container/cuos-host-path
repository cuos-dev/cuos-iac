#!/bin/bash
# SPDX-License-Identifier: Apache-2.0

# Path to the real docker binary (avoid recursion, see ./docker script)
DOCKER_REAL="${DOCKER_REAL:-/usr/bin/docker}"

# Usage: ./resolve_host_path.sh /path/inside/container
container_path="$(realpath "$1")"

if [ -z "$container_path" ]; then
  echo "Usage: $0 <path-inside-container>"
  exit 1
fi

# exclusions:
case "$1" in
  "/root/.docker/config.json") echo "$1";exit;;
  "/var/run/docker.sock") echo "$1";exit;;
  "/run/docker.sock") echo "$1";exit;;
  "/var/run/cuos.sock") echo "$1";exit;;
  "/run/cuos.sock") echo "$1";exit;;
  "/etc/machine-id") echo "$1";exit;;
  "/system.json") echo "$1";exit;;
  "/dev") echo "$1";exit;;
  "/data") echo "$1";exit;;
  "/proc") echo "$1";exit;;
  "/run/systemd/journal/socket") echo "$1";exit;;
  "/var/log/journal") echo "$1";exit;;
esac

# Get list of all container IDs
container_ids="$(curl -s --unix-socket /var/run/docker.sock http://localhost/containers/json | jq -r '.[].Id')"

# Identify current container by matching root device
my_container_id=""
for id in $container_ids; do
  merged_dir="$(curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/${id}/json" | jq -r '.GraphDriver.Data.MergedDir')"
  [ -z "$merged_dir" ] && continue
  merged_dev=$(stat -c %d "$merged_dir" 2>/dev/null)
  if [ "$merged_dev" = "$(stat -c %d /)" ]; then
    my_container_id="$id"
    break
  fi
done

[ -z "$my_container_id" ] && {
  echo "Could not identify current container."
  exit 1
}

# Get mount points of the current container
mounts="$(curl -s --unix-socket /var/run/docker.sock \
    "http://localhost/containers/${my_container_id}/json" |
  jq -c '
    .Mounts
    | map({Source: (.Source // .Mountpoint), Destination})
    | sort_by(.Destination | length) | reverse
    | .[]
  ')"

# Find the mount that contains the container path
for mount in $mounts; do
  source=$(echo "$mount" | jq -r '.Source')
  destination=$(echo "$mount" | jq -r '.Destination')

  # Check if the container path starts with this mount point
  case "$container_path" in
    "$destination"/*|"$destination")
      relative_path="${container_path#"$destination"}"
      echo "$source$relative_path"
      exit 0
      ;;
  esac
done

merged_dir="$("${DOCKER_REAL}" inspect -f '{{ .GraphDriver.Data.MergedDir }}' "$my_container_id")"

echo "${merged_dir}${container_path}"

