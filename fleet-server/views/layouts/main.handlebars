<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>CuOS Fleet</title>
  <style>
    body { font-family: system-ui, Arial, sans-serif; margin:20px; background:#f5f5f7; }
    h1 { margin-top:0; }
    table { border-collapse: collapse; width:100%; background:white; }
    th, td { padding:6px 8px; border:1px solid #ddd; font-size:14px; }
    th { background:#222; color:#fff; position:sticky; top:0; }
    tr:nth-child(even) { background:#fafafa; }
    .status-online { color: #0a0; }
    .status-offline { color: #999; }
    .status-updating { color: #e67e22; }
    .status-error { color: #c00; }
    .status-running { color: #0a0; }
    .metrics-cell { font-variant-numeric: tabular-nums; }
    form.inline { display:inline; }
    button { cursor:pointer; }
  </style>
</head>
<body>
  {{{body}}}
</body>
</html>
